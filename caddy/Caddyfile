http://* {
  redir /jellyfin /jellyfin/ permanent
  redir /qbit /qbit/ permanent
  redir /timetagger /timetagger/ permanent

  handle_path /jellyfin* {
    reverse_proxy http://jellyfin:8096
  }
  handle_path /seerr* {
    redir {host}:5055{uri}
  }
  handle /radarr* {
    reverse_proxy http://gluetun:7878
  }
  handle /sonarr* {
    reverse_proxy http://gluetun:8989
  }
  handle_path /qbit* {
    reverse_proxy http://gluetun:8080
  }
  handle /timetagger* {
    reverse_proxy http://timetagger:80
  }
  handle_path /pihole* {
    redir {host}:8002{uri}
  }

  handle / {
    rewrite index.html
    root /etc/caddy
    file_server
  }
}
